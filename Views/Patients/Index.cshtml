@model IEnumerable<ClinicManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "المرضى";
}

<h1>المرضى</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">إضافة مريض جديد</a>
</p>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row gx-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">بحث بالاسم أو الهاتف</label>
            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="اسم المريض أو رقم الهاتف..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary w-100">بحث</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">إلغاء</a>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FullName)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Age)</th>
            <th>@Html.DisplayNameFor(model => model.Gender)</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.FullName)</td>
            <td>@Html.DisplayFor(modelItem => item.Phone)</td>
            <td>@Html.DisplayFor(modelItem => item.Age)</td>
            <td>@(item.Gender == ClinicManagementSystem.Models.Gender.Male ? "ذكر" : "أنثى")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a> |
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المريض؟');">
                    <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
