@model IEnumerable<ClinicManagementSystem.Models.Receptionist>
@{
    ViewData["Title"] = "تم حجز الموعد المبدئي";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-lg p-5 rounded-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: none;">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                
                <h1 class="display-5 fw-bold text-success mb-3">تم استلام طلب الحجز</h1>
                
                <p class="lead text-muted mb-4">
                    لقد تم تسجيل حجزك المبدئي بنجاح.<br />
                    خطوتك الأخيرة هي التواصل مع الاستقبال لتأكيد <strong>الوقت الدقيق</strong> للموعد وترتيب <strong>طريقة الدفع</strong>.
                </p>

                <div class="alert alert-info d-flex align-items-center justify-content-center mx-auto" style="max-width: 500px;" role="alert">
                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                    <div>
                        الرجاء النقر على أحد الأزرار أدناه لفتح محادثة واتساب مع العيادة وتأكيد الموعد.
                    </div>
                </div>

                <div class="mt-4">
                    @if (Model != null && Model.Any())
                    {
                        <h5 class="fw-bold mb-3">اختر أحد موظفي الاستقبال للتواصل معه:</h5>
                        <div class="d-flex flex-column gap-2 align-items-center">
                            @foreach (var receptionist in Model)
                            {
                                <a href="https://wa.me/2@(receptionist.Phone)?text=مرحباً، لقد قمت بحجز موعد مبدئي عبر الموقع وأريد تأكيده." 
                                   target="_blank" 
                                   class="btn btn-success btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm w-100" style="max-width: 400px;">
                                    <i class="bi bi-whatsapp me-2"></i> تواصل مع @receptionist.FullName
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            عذراً، لا يوجد أرقام استقبال متاحة حالياً. يرجى مراجعة العيادة لاحقاً.
                        </div>
                    }
                </div>
                
                <div class="mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        العودة لقائمة مواعيدي
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
