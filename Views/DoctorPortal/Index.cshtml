@model ClinicManagementSystem.Models.ViewModels.DoctorDashboardViewModel
@{
    ViewData["Title"] = "بوابة الطبيب - لوحة التحكم";
}

@functions {
    public string GetDayNameArabic(DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Sunday => "الأحد",
            DayOfWeek.Monday => "الإثنين",
            DayOfWeek.Tuesday => "الثلاثاء",
            DayOfWeek.Wednesday => "الأربعاء",
            DayOfWeek.Thursday => "الخميس",
            DayOfWeek.Friday => "الجمعة",
            DayOfWeek.Saturday => "السبت",
            _ => day.ToString()
        };
    }
}

<style>
    .kpi-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.3s ease;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
    }
    .kpi-card:hover {
        transform: translateY(-5px);
    }
    .kpi-icon {
        font-size: 2.5rem;
        opacity: 0.8;
    }
    .nav-pills .nav-link.active {
        background-color: #0d6efd;
        color: white;
        border-radius: 50rem;
    }
    .nav-pills .nav-link {
        color: #495057;
        border-radius: 50rem;
        margin-left: 5px;
        font-weight: bold;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-speedometer2 text-primary"></i> لوحة تحكم الطبيب | د. @ViewBag.DoctorName</h2>
</div>

<!-- KPI Cards Row -->
<div class="row mb-5 justify-content-center g-4">
    <div class="col-md-5">
        <div class="card kpi-card h-100 p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 fw-bold">إجمالي المواعيد المؤكدة</p>
                    <h2 class="mb-0 fw-bold text-warning">@Model.ConfirmedAppointmentsCount</h2>
                </div>
                <div class="kpi-icon text-warning">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card kpi-card h-100 p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 fw-bold">إجمالي المكتمل</p>
                    <h2 class="mb-0 fw-bold text-success">@Model.CompletedAppointmentsCount</h2>
                </div>
                <div class="kpi-icon text-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Appointments Tabs -->
<div class="card shadow-sm border-0" style="border-radius: 15px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
    @if (!Model.ScheduledDays.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x text-muted mb-3" style="font-size: 3rem; opacity: 0.5;"></i>
            <h5 class="text-muted fw-bold">لم تقم بتحديد مواعيد عملك الأسبوعية بعد.</h5>
            <p class="text-muted">يرجى الذهاب إلى <a asp-action="Schedule" class="text-primary fw-bold text-decoration-none">إدارة مواعيد العمل</a> لإضافة أيام وساعات دوامك بالعيادة.</p>
        </div>
    }
    else
    {
        <div class="card-header bg-transparent border-0 pt-4 pb-0">
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                @for (int i = 0; i < Model.ScheduledDays.Count; i++)
                {
                    var day = Model.ScheduledDays[i];
                    var isActive = i == 0 ? "active" : "";
                    var dayNameAr = GetDayNameArabic(day);
                    var count = Model.AppointmentsByDay.ContainsKey(day) ? Model.AppointmentsByDay[day].Count : 0;
                    
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @isActive px-4 shadow-sm" id="pills-@day-tab" data-bs-toggle="pill" data-bs-target="#pills-@day" type="button" role="tab" aria-controls="pills-@day" aria-selected="@(i == 0 ? "true" : "false")">
                            <i class="bi bi-calendar-day me-2"></i> مواعيد يوم @dayNameAr
                            <span class="badge bg-light text-dark ms-2">@count</span>
                        </button>
                    </li>
                }
            </ul>
        </div>
        
        <div class="card-body p-0">
            <div class="tab-content" id="pills-tabContent">
                @for (int i = 0; i < Model.ScheduledDays.Count; i++)
                {
                    var day = Model.ScheduledDays[i];
                    var isActive = i == 0 ? "show active" : "";
                    var appointments = Model.AppointmentsByDay.ContainsKey(day) ? Model.AppointmentsByDay[day] : new List<ClinicManagementSystem.Models.Appointment>();
                    
                    <div class="tab-pane fade @isActive" id="pills-@day" role="tabpanel" aria-labelledby="pills-@day-tab">
                        @await Html.PartialAsync("_AppointmentsTable", appointments)
                    </div>
                }
            </div>
        </div>
    }
</div>
