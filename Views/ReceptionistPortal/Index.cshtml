@model IEnumerable<ClinicManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "لوحة الاستقبال - إدارة الحجوزات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold" style="background: linear-gradient(45deg, #20c997, #0dcaf0); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        <i class="bi bi-headset"></i> لوحة تحكم الاستقبال
    </h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-pills mb-4 gap-2" id="receptionistTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active rounded-pill fw-bold px-4" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab" aria-controls="pending" aria-selected="true">
            <i class="bi bi-hourglass-split"></i> قيد الانتظار (جديدة)
            <span class="badge bg-danger rounded-circle ms-2">@Model.Count(a => a.Status == ClinicManagementSystem.Models.AppointmentStatus.Pending)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill fw-bold px-4" id="confirmed-tab" data-bs-toggle="tab" data-bs-target="#confirmed" type="button" role="tab" aria-controls="confirmed" aria-selected="false">
            <i class="bi bi-calendar-check"></i> الحجوزات المؤكدة
            <span class="badge bg-success rounded-circle ms-2">@Model.Count(a => a.Status == ClinicManagementSystem.Models.AppointmentStatus.Confirmed)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill fw-bold px-4" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab" aria-controls="completed" aria-selected="false">
            <i class="bi bi-check2-all"></i> المكتملة
        </button>
    </li>
</ul>

<div class="tab-content" id="receptionistTabsContent">
    <!-- Pending Appointments Tab -->
    <div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
        <div class="card shadow-lg border-0 rounded-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>المريض</th>
                                <th>الهاتف</th>
                                <th>الطبيب</th>
                                <th>تاريخ الطلب (اليوم)</th>
                                <th class="text-center">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(a => a.Status == ClinicManagementSystem.Models.AppointmentStatus.Pending))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-primary">@item.Patient?.FullName</div>
                                    </td>
                                    <td>
                                        <a href="https://wa.me/20@(item.Patient?.Phone?.StartsWith("0") == true ? item.Patient.Phone.Substring(1) : item.Patient?.Phone)" target="_blank" class="text-decoration-none text-success fw-bold">
                                            <i class="bi bi-whatsapp"></i> @item.Patient?.Phone
                                        </a>
                                    </td>
                                    <td>@item.Doctor?.FullName</td>
                                    <td>
                                        <div class="badge bg-secondary">
                                            <i class="bi bi-calendar-date"></i> @item.AppointmentDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="ConfirmAppointment" asp-route-id="@item.Id" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                                            <i class="bi bi-check-circle"></i> تأكيد وتحديد الوقت
                                        </a>
                                        <form asp-action="CancelAppointment" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="return confirm('هل أنت متأكد من إلغاء هذا الحجز؟');">
                                                <i class="bi bi-x-circle"></i> إلغاء
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any(a => a.Status == ClinicManagementSystem.Models.AppointmentStatus.Pending))
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">لا يوجد طلبات حجز قيد الانتظار.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmed Appointments Tab -->
    <div class="tab-pane fade" id="confirmed" role="tabpanel" aria-labelledby="confirmed-tab">
        <div class="card shadow-lg border-0 rounded-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>المريض</th>
                                <th>الهاتف</th>
                                <th>الطبيب</th>
                                <th>الموعد الدقيق</th>
                                <th>الدفع</th>
                                <th class="text-center">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(a => a.Status == ClinicManagementSystem.Models.AppointmentStatus.Confirmed))
                            {
                                <tr>
                                    <td><div class="fw-bold">@item.Patient?.FullName</div></td>
                                    <td>@item.Patient?.Phone</td>
                                    <td>@item.Doctor?.FullName</td>
                                    <td>
                                        <div class="badge bg-primary fs-6">
                                            @item.AppointmentDate.ToString("yyyy-MM-dd hh:mm tt")
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.IsPaid)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check"></i> مدفوع (@item.PaymentMethod)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> لم يتم الدفع</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="CompleteAppointment" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="return confirm('هل اكتملت الزيارة؟');">
                                                <i class="bi bi-check2-all"></i> اكتملت الزيارة
                                            </button>
                                        </form>
                                        <a asp-action="ConfirmAppointment" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill shadow-sm">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any(a => a.Status == ClinicManagementSystem.Models.AppointmentStatus.Confirmed))
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">لا يوجد حجوزات مؤكدة.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Completed & Cancelled Appointments Tab -->
    <div class="tab-pane fade" id="completed" role="tabpanel" aria-labelledby="completed-tab">
        <div class="card shadow-lg border-0 rounded-4 opacity-75" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>المريض</th>
                                <th>الطبيب</th>
                                <th>الموعد</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(a => a.Status == ClinicManagementSystem.Models.AppointmentStatus.Completed || a.Status == ClinicManagementSystem.Models.AppointmentStatus.Cancelled).OrderByDescending(a=>a.AppointmentDate).Take(50))
                            {
                                <tr>
                                    <td>@item.Patient?.FullName</td>
                                    <td>@item.Doctor?.FullName</td>
                                    <td>@item.AppointmentDate.ToString("yyyy-MM-dd hh:mm tt")</td>
                                    <td>
                                        @if (item.Status == ClinicManagementSystem.Models.AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-success">مكتمل</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">ملغي</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
